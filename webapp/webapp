#!/usr/bin/env bash
# Turn any URL into a real desktop app: own icon, own taskbar entry, no tab.
#
# The reason this needs a script at all is the window-matching trap. Chromium's
# --app mode invents a WM class from the URL (chrome-localhost__8123-Default),
# which changes if the URL changes and which no .desktop file declares. Plasma
# then cannot match the window back to a launcher, so the running app shows up
# as a second, generic, unpinnable icon next to the one you pinned. Passing an
# explicit --class AND declaring the same string as StartupWMClass is what makes
# the pinned icon and the live window the same object.
set -euo pipefail

APPS="$HOME/.local/share/applications"
ICONS="$HOME/.local/share/icons"
PREFIX=webapp

die() { echo "error: $*" >&2; exit 1; }

# Chromium-family only: --app is what gives a chromeless window with its own
# identity. Firefox has no equivalent (SSB was removed in 2021), so it is not a
# fallback -- see README.
find_browser() {
  local b
  for b in brave-browser brave google-chrome-stable google-chrome chromium \
           chromium-browser microsoft-edge-stable microsoft-edge vivaldi-stable; do
    command -v "$b" >/dev/null 2>&1 && { command -v "$b"; return 0; }
  done
  return 1
}

slugify() { echo "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//;s/-*$//'; }

# Deterministic colour per name, so an app keeps its colour across reinstalls
# and two apps rarely collide.
pick_colour() {
  local sum=0 c
  for ((i = 0; i < ${#1}; i++)); do printf -v c '%d' "'${1:i:1}"; sum=$((sum + c)); done
  local palette=(41BDF5 7C5CFF F5871F 2FB673 E5484D 0FA0CE D6409F 8B5CF6 059669 DC7633)
  echo "${palette[$((sum % ${#palette[@]}))]}"
}

write_icon() {
  local slug=$1 name=$2 supplied=${3:-} out="$ICONS/$PREFIX-$slug.svg"
  mkdir -p "$ICONS"

  if [[ -n $supplied && -f $supplied ]]; then
    case ${supplied,,} in
      *.svg) cp -f "$supplied" "$out" ;;
      *)     out="$ICONS/$PREFIX-$slug.${supplied##*.}"; cp -f "$supplied" "$out" ;;
    esac
    echo "$out"; return
  fi

  local glyph colour
  colour=$(pick_colour "$name")
  # A short supplied string is treated as the glyph itself, so `webapp add Home
  # http://... 🏠` works. Otherwise fall back to the first letter.
  if [[ -n $supplied && ${#supplied} -le 2 ]]; then glyph=$supplied
  else glyph=$(echo "${name:0:1}" | tr '[:lower:]' '[:upper:]'); fi

  cat > "$out" <<EOF
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" width="256" height="256">
  <rect width="256" height="256" rx="56" fill="#$colour"/>
  <text x="128" y="128" text-anchor="middle" dominant-baseline="central"
        font-family="Noto Color Emoji, Segoe UI, DejaVu Sans, sans-serif"
        font-size="132" font-weight="600" fill="#ffffff">$glyph</text>
</svg>
EOF
  echo "$out"
}

cmd_add() {
  local name=${1:-} url=${2:-} icon=${3:-}
  [[ -n $name && -n $url ]] || die "usage: webapp add <name> <url> [icon-file|glyph]"
  [[ $url =~ ^https?:// ]] || die "url must start with http:// or https://"

  local browser slug desktop iconpath
  browser=$(find_browser) || die "no Chromium-family browser found (brave/chrome/chromium/edge/vivaldi)"
  slug=$(slugify "$name")
  [[ -n $slug ]] || die "name produced an empty slug"
  desktop="$APPS/$PREFIX-$slug.desktop"
  iconpath=$(write_icon "$slug" "$name" "$icon")

  mkdir -p "$APPS"
  cat > "$desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$name
Comment=$url
Exec=$browser --app=$url --class=$PREFIX-$slug
Icon=$iconpath
StartupWMClass=$PREFIX-$slug
Terminal=false
Categories=Network;
X-Webapp-Url=$url
EOF
  chmod +x "$desktop"
  update-desktop-database "$APPS" 2>/dev/null || true

  echo ":: added \"$name\" -> $url"
  echo "   launcher $desktop"
  echo "   icon     $iconpath"
  echo "   browser  $browser"
  echo
  echo ":: pin it: open the app launcher, find \"$name\", right-click -> Pin to Task Manager"
}

cmd_list() {
  shopt -s nullglob
  local f found=0
  for f in "$APPS/$PREFIX-"*.desktop; do
    found=1
    printf '  %-24s %s\n' "$(sed -n 's/^Name=//p' "$f")" "$(sed -n 's/^X-Webapp-Url=//p' "$f")"
  done
  ((found)) || echo "  (none yet -- webapp add <name> <url>)"
}

cmd_remove() {
  local slug; slug=$(slugify "${1:?usage: webapp remove <name>}")
  local n=0 f
  for f in "$APPS/$PREFIX-$slug.desktop" "$ICONS/$PREFIX-$slug".*; do
    [[ -e $f ]] && { rm -f "$f"; n=$((n + 1)); }
  done
  update-desktop-database "$APPS" 2>/dev/null || true
  ((n)) && echo ":: removed $slug ($n files)" || echo ":: nothing named $slug"
}

case ${1:-list} in
  add)    shift; cmd_add "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  list)   cmd_list ;;
  *)      echo "usage: webapp add <name> <url> [icon-file|glyph] | list | remove <name>" ;;
esac
