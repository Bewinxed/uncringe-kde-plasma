#!/usr/bin/env bash
# latin-locale - any region's formats (currency, metric/imperial, paper, phone,
# weekend) WITHOUT that region's native digit rendering in Qt/KDE apps.
#
# WHY THIS EXISTS
#   Setting e.g. ar_QA gives Qatar formats but fills every Qt app with
#   Arabic-Indic digits (or Devanagari for hi_IN, Bengali for bn_BD, ...).
#   glibc's `locale` output is misleading here: Qt does NOT read glibc locale
#   data for digit shapes - it uses its own CLDR tables, where many locales
#   default to native numbering. Verified dead ends: Qt ignores @numbers=latn
#   and -u-nu-latn entirely; invented locales (en_QA) fall back to en_US
#   (Imperial, M/D/YY); en_GB as base loses metric.
#
#   What works: Qt honours per-category LC_* overrides. Keep the regional
#   categories on the target locale, move only the digit-rendering categories
#   (LC_NUMERIC, LC_TIME) to a Latin-digit locale.
#
# NO HARDCODING
#   Every locale is validated against the system's own registry
#   (/usr/share/i18n/SUPPORTED) and generated on demand with localedef.
#   The target user is whoever invoked sudo. The output is derived, not typed.
#
# USAGE
#   sudo latin-locale ar_QA                    # Qatar formats, Latin digits
#   sudo latin-locale ar_SA --digits en_US     # Saudi formats, US date order
#   sudo latin-locale hi_IN --ui en_GB         # India, British English UI
#   latin-locale --list [pattern]              # what regions are available
#   sudo latin-locale --dry-run ar_AE          # show what would be written
#   sudo latin-locale --revert                 # restore the pre-change config
set -euo pipefail

SUPPORTED=/usr/share/i18n/SUPPORTED
UI="en_US.UTF-8"          # interface language      (--ui)
DIGITS="en_GB.UTF-8"      # digits + date rendering (--digits; en_GB = day-first)
DRY=0

usage() { sed -n '/^# USAGE/,/^set -e/p' "$0" | sed 's/^# \{0,1\}//;$d'; exit "${1:-0}"; }

# --- resolve a user-supplied locale name against the system registry ---------
canon() {
  local want=$1 line name
  # accept "ar_QA", "ar_QA.UTF-8", case-insensitive
  want=${want%.UTF-8}; want=${want%.utf8}
  while read -r name _; do
    [[ ${name%.UTF-8} == "$want" ]] && { echo "$name"; return 0; }
  done < <(grep -i "UTF-8" "$SUPPORTED")
  return 1
}

ensure_generated() {
  local loc=$1 norm=${1/.UTF-8/.utf8}
  locale -a 2>/dev/null | grep -qix "$norm" && return 0
  echo ":: generating $loc"
  localedef -i "${loc%.UTF-8}" -f UTF-8 "$loc"
}

# --- args --------------------------------------------------------------------
REGION_ARG="" ; REVERT=0 ; LIST=0 ; LIST_PAT=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --ui)      UI=$2; shift 2 ;;
    --digits)  DIGITS=$2; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    --revert)  REVERT=1; shift ;;
    --list)    LIST=1; LIST_PAT=${2:-}; [[ $# -gt 1 ]] && shift; shift ;;
    -h|--help) usage ;;
    -*)        echo "unknown flag: $1" >&2; usage 1 ;;
    *)         REGION_ARG=$1; shift ;;
  esac
done

if [[ $LIST -eq 1 ]]; then
  echo "available UTF-8 region locales${LIST_PAT:+ matching '$LIST_PAT'}:"
  grep "UTF-8" "$SUPPORTED" | awk '{print "  "$1}' | grep -i "${LIST_PAT:-.}" || true
  exit 0
fi

[[ $EUID -eq 0 ]] || { echo "error: run me with sudo" >&2; exit 1; }
TARGET_USER=${SUDO_USER:?run via sudo from your desktop user, not a root shell}
TARGET_HOME=$(getent passwd "$TARGET_USER" | cut -d: -f6)
# /etc/default/locale may be a SYMLINK (e.g. -> /etc/locale.conf): resolve it,
# or the backup silently tracks the file being overwritten.
SYSLOC=$(readlink -f /etc/default/locale 2>/dev/null || echo /etc/locale.conf)
RC="$TARGET_HOME/.config/plasma-localerc"

if [[ $REVERT -eq 1 ]]; then
  [[ -f $SYSLOC.orig ]] || { echo "no backup at $SYSLOC.orig" >&2; exit 1; }
  cp -a "$SYSLOC.orig" "$SYSLOC"
  [[ -f $RC.orig ]] && cp -a "$RC.orig" "$RC" && chown "$TARGET_USER": "$RC"
  echo ":: restored $SYSLOC (and plasma-localerc if backed up). Re-login to apply."
  exit 0
fi

[[ -n $REGION_ARG ]] || usage 1
REGION=$(canon "$REGION_ARG") || {
  echo "error: '$REGION_ARG' is not in $SUPPORTED. Try: latin-locale --list ${REGION_ARG%%_*}" >&2
  exit 1; }
UI=$(canon "$UI")         || { echo "error: unknown --ui locale" >&2; exit 1; }
DIGITS=$(canon "$DIGITS") || { echo "error: unknown --digits locale" >&2; exit 1; }

echo ":: region=$REGION  digits/time=$DIGITS  ui=$UI  user=$TARGET_USER"

if [[ $DRY -eq 1 ]]; then
  echo "-- would write $SYSLOC and $RC with:"
else
  for l in "$REGION" "$DIGITS" "$UI"; do ensure_generated "$l"; done
  [[ -f $SYSLOC.orig ]] || cp -aL "$SYSLOC" "$SYSLOC.orig" 2>/dev/null || true
  [[ -f $RC && ! -f $RC.orig ]] && cp -a "$RC" "$RC.orig"
fi

CONTENT="# Generated by latin-locale ($REGION formats, $DIGITS digits, $UI UI).
# Pre-change state: $SYSLOC.orig   Revert: sudo latin-locale --revert
LANG=$UI
LC_NUMERIC=$DIGITS
LC_TIME=$DIGITS
LC_MONETARY=$REGION
LC_MEASUREMENT=$REGION
LC_PAPER=$REGION
LC_TELEPHONE=$REGION
LC_ADDRESS=$REGION
LC_NAME=$REGION
LC_IDENTIFICATION=$REGION"

PLASMA="[Formats]
LANG=$UI
useDetailed=true
LC_NUMERIC=$DIGITS
LC_TIME=$DIGITS
LC_MONETARY=$REGION
LC_MEASUREMENT=$REGION
LC_PAPER=$REGION
LC_TELEPHONE=$REGION
LC_ADDRESS=$REGION
LC_NAME=$REGION"

if [[ $DRY -eq 1 ]]; then
  echo "$CONTENT"; echo; echo "$PLASMA"; exit 0
fi

echo ":: writing $SYSLOC"
echo "$CONTENT" > "$SYSLOC"
echo ":: writing $RC"
echo "$PLASMA" > "$RC"
chown "$TARGET_USER": "$RC"

echo
echo "verifying (glibc view - remember Qt renders digits from its own CLDR data):"
env LANG="$UI" LC_NUMERIC="$DIGITS" LC_TIME="$DIGITS" LC_MONETARY="$REGION" \
    LC_MEASUREMENT="$REGION" LC_PAPER="$REGION" bash -c '
  date
  printf "number:    %s\n" "$(awk "BEGIN{printf \"%'"'"'.2f\", 1234567.891}")"
  locale -k int_curr_symbol measurement height 2>/dev/null | grep -v codeset | sed "s/^/  /"'
# Qt check when PyQt6 is around (optional)
if runuser -u "$TARGET_USER" -- python3 -c "import PyQt6" 2>/dev/null; then
  echo "Qt view:"
  runuser -u "$TARGET_USER" -- env LANG="$UI" LC_NUMERIC="$DIGITS" LC_TIME="$DIGITS" \
    LC_MONETARY="$REGION" LC_MEASUREMENT="$REGION" python3 - <<'PY'
from PyQt6.QtCore import QLocale, QDate
L = QLocale.system()
metric = L.measurementSystem() == QLocale.MeasurementSystem.MetricSystem
print(f"  digits={L.zeroDigit()}123  number={L.toString(12345.67,'f',2)}  "
      f"date={L.toString(QDate(2026,7,25), QLocale.FormatType.ShortFormat)}  "
      f"currency={L.toCurrencyString(1234.5)}  metric={metric}")
PY
fi
echo
echo "Log out and back in for the whole session to pick it up."
echo "KDE's Region & Language GUI rewrites plasma-localerc on Apply - just re-run me."
