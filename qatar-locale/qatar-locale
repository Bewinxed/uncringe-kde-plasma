#!/usr/bin/env bash
# Qatar regional settings with Latin numerals in KDE/Qt apps.
#
# WHY THIS IS NEEDED
#   Qt/Plasma does NOT use glibc locale data for digit shapes - it uses its own
#   CLDR tables, where ar_QA's default numbering system is "arab" (Arabic-Indic:
#   ٠١٢٣٤٥٦٧٨٩). So `locale` reporting decimal_point="." tells you nothing about
#   what the panel clock will render. Setting LC_NUMERIC=ar_QA is what forces
#   Arabic-Indic digits into every Qt app.
#
#   Qt also ignores the CLDR numbering-system extension entirely - all of
#   ar_QA@numbers=latn, ar_QA-u-nu-latn, ar-QA-u-nu-latn resolve back to arab.
#   And en_QA does not exist in Qt's data: it silently falls back to en_US,
#   which is IMPERIAL and M/D/YY. Neither is a usable escape hatch.
#
#   What DOES work: Qt honours per-category LC_* overrides. Keep the regional
#   categories on ar_QA (metric, A4, QAR, +974) and override just the two that
#   control digit rendering - LC_NUMERIC and LC_TIME - with en_GB.
#
#   en_GB is used for those two rather than en_US because en_GB gives
#   day/month/year ordering. en_GB is NOT used as the base locale because Qt
#   reports en_GB as Imperial, which would lose metric.
#
# Usage: sudo qatar-locale
set -euo pipefail

REGION=ar_QA.UTF-8      # metric, A4, QAR, +974, Qatar address/name formats
LATIN=en_GB.UTF-8       # Latin digits, day-first dates
UI=en_US.UTF-8          # interface language

[[ $EUID -eq 0 ]] || { echo "error: run me with sudo" >&2; exit 1; }

TARGET_USER=${SUDO_USER:-root}
TARGET_HOME=$(getent passwd "$TARGET_USER" | cut -d: -f6)

# Both locales must actually be compiled or setlocale() falls back to C.
for l in "$REGION" "$LATIN" "$UI"; do
  if ! locale -a 2>/dev/null | grep -qix "${l/.UTF-8/.utf8}"; then
    echo ":: generating missing locale $l"
    localedef -i "${l%.UTF-8}" -f UTF-8 "$l"
  fi
done

# On Kubuntu /etc/default/locale is a SYMLINK to /etc/locale.conf. Resolve it,
# or `cp -a` backs up the link and the "backup" tracks the file we overwrite.
SYSLOC=$(readlink -f /etc/default/locale)
echo ":: writing $SYSLOC"
[[ -f $SYSLOC.orig ]] || cp -aL "$SYSLOC" "$SYSLOC.orig"
cat > "$SYSLOC" <<EOF
# Generated by qatar-locale. Pre-change state saved as $SYSLOC.orig
# Qatar regional formats, Latin numerals. See ~/.local/bin/qatar-locale.
LANG=$UI
LC_NUMERIC=$LATIN
LC_TIME=$LATIN
LC_MONETARY=$REGION
LC_MEASUREMENT=$REGION
LC_PAPER=$REGION
LC_TELEPHONE=$REGION
LC_ADDRESS=$REGION
LC_NAME=$REGION
LC_IDENTIFICATION=$REGION
EOF

echo ":: writing Plasma formats for $TARGET_USER"
RC="$TARGET_HOME/.config/plasma-localerc"
cat > "$RC" <<EOF
[Formats]
LANG=$UI
useDetailed=true
LC_NUMERIC=$LATIN
LC_TIME=$LATIN
LC_MONETARY=$REGION
LC_MEASUREMENT=$REGION
LC_PAPER=$REGION
LC_TELEPHONE=$REGION
LC_ADDRESS=$REGION
LC_NAME=$REGION
EOF
chown "$TARGET_USER": "$RC"

echo
echo "verifying (this is what Qt apps will render):"
env LANG="$UI" LC_NUMERIC="$LATIN" LC_TIME="$LATIN" LC_MONETARY="$REGION" \
    LC_MEASUREMENT="$REGION" LC_PAPER="$REGION" LC_TELEPHONE="$REGION" \
    python3 - <<'PY' 2>/dev/null || echo "  (PyQt6 not available, skipping Qt check)"
from PyQt6.QtCore import QLocale, QDate
L = QLocale.system()
metric = L.measurementSystem() == QLocale.MeasurementSystem.MetricSystem
print(f"  digits    {L.zeroDigit()}123456789   <- must be Latin, not ٠١٢٣")
print(f"  number    {L.toString(12345.67, 'f', 2)}")
print(f"  date      {L.toString(QDate(2026,7,25), QLocale.FormatType.ShortFormat)}")
print(f"  currency  {L.toCurrencyString(1234.5)}")
print(f"  metric    {metric}")
PY
echo
echo "Log out and back in for the whole session to pick it up."
