#!/usr/bin/env bash
# crisp - sharp text AND sharp bitmaps at native scale. No hardcoded values:
# the panel is measured, the DPI is derived.
#
# WHY
#   Display scaling and font DPI are DIFFERENT levers. Scaling renders the UI at
#   96 DPI then *resamples* it: bigger, but every cached bitmap gets interpolated
#   - that is the blurry-favicon bug (Chromium needs 20px icons at 1.25x, has
#   16px cached, upscales). Raising font DPI instead makes toolkits rasterise
#   glyphs at a larger size NATIVELY: bigger AND sharper, nothing resampled.
#
# MEASUREMENT (methodology from github.com/acrion/wayland-font-dpi)
#   true_dpi = diagonal_px / diagonal_inch, from the panel's EDID physical size.
#   target font DPI = round(true_dpi * comfort), comfort defaulting to 1.10.
#
#   Read the EDID size from `kscreen-doctor -j` (KWin's own view) - NEVER from
#   xdpyinfo: XWayland *synthesizes* its millimetre values to force 96 DPI
#   (mm = px/96*25.4 exactly), so it always "measures" 96 and the derivation
#   silently becomes a no-op. That synthetic value masqueraded as a real
#   measurement here once; kscreen reports the EDID truth.
#
# OTHER LESSONS ENCODED BELOW
#   * Subpixel AA is NOT the issue: measured on this stack, Chromium page text
#     is 82-84% colour-fringed (subpixel active) while KDE panel text is 0.4%
#     (grayscale) in the same Wayland session. Qt choice, not Wayland limit.
#   * hintfull + FreeType interpreter-version=35 is the real lever for thin
#     light-on-dark text. Stem darkening is a no-op in FreeType's TrueType driver.
#   * ~/.config/fontconfig/fonts.conf is parsed AFTER conf.d/, so hintstyle must
#     be fixed at its source or a conf.d override silently loses.
#   * GTK reads none of KDE's font settings: propagate DPI/96 via gsettings
#     text-scaling-factor (immediate). Verified not to leak into Chromium's
#     devicePixelRatio, so it cannot re-blur favicons.
#
# Usage:
#   crisp apply [comfort]   # measure panel, derive DPI, apply everything
#   crisp dpi <N>           # manual DPI override (Qt + GTK together)
#   crisp status
#   crisp revert
set -euo pipefail

COMFORT_DEFAULT=1.10
FC="$HOME/.config/fontconfig/conf.d/99-crisp.conf"
ENVD="$HOME/.config/environment.d/95-crisp.conf"
KG="$HOME/.config/kdeglobals"
BAK="$HOME/.config/kdeglobals.crisp-bak"
STATE="$HOME/.config/crisp.state"
FTPROPS="truetype:interpreter-version=35"

# --- measure the primary panel via KWin's JSON API ---------------------------
probe() {  # prints: name px_w px_h mm_w mm_h scale true_dpi
  kscreen-doctor -j 2>/dev/null | python3 -c '
import json, sys, math
d = json.load(sys.stdin)
outs = [o for o in d["outputs"] if o.get("enabled")]
outs.sort(key=lambda o: o.get("priority") or 99)
o = outs[0]
mode = next((m for m in o["modes"] if m["id"] == o.get("currentModeId")), None)
px_w, px_h = mode["size"]["width"], mode["size"]["height"]
mm = o.get("sizeMM") or o.get("sizeMm") or {}
mm_w, mm_h = mm.get("width") or 0, mm.get("height") or 0
if mm_w and mm_h:
    dpi = math.hypot(px_w, px_h) / (math.hypot(mm_w, mm_h) / 25.4)
else:
    dpi = 96.0   # EDID missing: fall back to the legacy baseline
print(o["name"], px_w, px_h, mm_w, mm_h, o.get("scale") or 1, f"{dpi:.1f}")'
}

gtk_set() {
  command -v gsettings >/dev/null 2>&1 || return 0
  gsettings set org.gnome.desktop.interface text-scaling-factor "$1" || true
}

set_dpi() {  # Qt (kdeglobals) + GTK (gsettings), one factor
  kwriteconfig6 --file kdeglobals --group General --key forceFontDPI "$1"
  kwriteconfig6 --file kdeglobals --group General --key forceFontDPIWayland "$1"
  gtk_set "$(python3 -c "print(round($1/96, 4))")"
}

case ${1:-status} in
apply)
  read -r OUT PXW PXH MMW MMH SCALE TRUEDPI < <(probe)
  [[ -n ${OUT:-} ]] || { echo "error: could not probe outputs (kscreen-doctor -j)"; exit 1; }
  COMFORT=${2:-${CRISP_COMFORT:-$COMFORT_DEFAULT}}
  DPI=$(python3 -c "print(round($TRUEDPI * $COMFORT))")
  echo ":: $OUT: ${PXW}x${PXH}px on ${MMW}x${MMH}mm -> true ${TRUEDPI} DPI"
  echo ":: comfort x$COMFORT -> font DPI $DPI (GTK factor $(python3 -c "print(round($DPI/96,4))"))"

  [[ -f $BAK ]] || cp -a "$KG" "$BAK"
  printf 'OUT=%s\nPREV_SCALE=%s\n' "$OUT" "$SCALE" > "$STATE"

  set_dpi "$DPI"
  kwriteconfig6 --file kdeglobals --group General --key XftHintStyle hintfull

  mkdir -p "$(dirname "$FC")"
  cat > "$FC" <<'EOF'
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!-- Written by `crisp`. Delete this file (or run `crisp revert`) to undo. -->
<fontconfig>
  <match target="font">
    <edit name="antialias"  mode="assign"><bool>true</bool></edit>
    <edit name="hinting"    mode="assign"><bool>true</bool></edit>
    <edit name="hintstyle"  mode="assign"><const>hintfull</const></edit>
    <edit name="rgba"       mode="assign"><const>rgb</const></edit>
    <edit name="lcdfilter"  mode="assign"><const>lcddefault</const></edit>
  </match>
</fontconfig>
EOF
  FONTSCONF="$HOME/.config/fontconfig/fonts.conf"
  if [[ -f $FONTSCONF ]] && grep -q 'hintslight' "$FONTSCONF"; then
    [[ -f $FONTSCONF.crisp-bak ]] || cp -a "$FONTSCONF" "$FONTSCONF.crisp-bak"
    sed -i 's|<const>hintslight</const>|<const>hintfull</const>|' "$FONTSCONF"
    echo ":: fonts.conf hintslight -> hintfull (it outranks conf.d)"
  fi

  mkdir -p "$(dirname "$ENVD")"
  echo "FREETYPE_PROPERTIES=$FTPROPS" > "$ENVD"
  systemctl --user set-environment "FREETYPE_PROPERTIES=$FTPROPS" 2>/dev/null || true

  # scale LAST - the only step that can disturb panel geometry
  if [[ $SCALE != 1 ]]; then
    echo ":: display scale $SCALE -> 1.0 (removes all bitmap resampling)"
    kscreen-doctor "output.$OUT.scale.1" >/dev/null 2>&1 || echo "   !! scale change failed"
  else
    echo ":: display scale already 1.0"
  fi
  echo
  echo "Log out and back in for font DPI to reach every app (GTK half is live now)."
  ;;
dpi)
  N=${2:?usage: crisp dpi <number>}
  set_dpi "$N"
  echo ":: font DPI -> $N (Qt + GTK). Re-login for Qt; GTK is immediate."
  ;;
revert)
  [[ -f $BAK ]] && cp -a "$BAK" "$KG" && echo ":: kdeglobals restored"
  FONTSCONF="$HOME/.config/fontconfig/fonts.conf"
  [[ -f $FONTSCONF.crisp-bak ]] && cp -a "$FONTSCONF.crisp-bak" "$FONTSCONF" \
    && echo ":: fonts.conf restored"
  rm -f "$FC" "$ENVD" && echo ":: fontconfig + env overrides removed"
  gtk_set 1.0
  systemctl --user unset-environment FREETYPE_PROPERTIES 2>/dev/null || true
  if [[ -f $STATE ]]; then
    # shellcheck disable=SC1090
    source "$STATE"
    [[ ${PREV_SCALE:-1} != 1 ]] && kscreen-doctor "output.$OUT.scale.$PREV_SCALE" >/dev/null 2>&1 \
      && echo ":: scale restored to $PREV_SCALE"
    rm -f "$STATE"
  fi
  echo "Log out and back in."
  ;;
status)
  read -r OUT PXW PXH MMW MMH SCALE TRUEDPI < <(probe) || true
  echo "panel         : ${OUT:-?} ${PXW:-?}x${PXH:-?}px ${MMW:-?}x${MMH:-?}mm -> true ${TRUEDPI:-?} DPI"
  echo "display scale : ${SCALE:-?}"
  for k in forceFontDPI forceFontDPIWayland XftHintStyle XftSubPixel XftAntialias; do
    printf '  %-20s %s\n' "$k" "$(kreadconfig6 --file kdeglobals --group General --key $k 2>/dev/null || echo unset)"
  done
  echo "fontconfig    : $([[ -f $FC ]] && echo "override present" || echo none)"
  echo "freetype      : ${FREETYPE_PROPERTIES:-unset in this shell}; file=$([[ -f $ENVD ]] && echo present || echo none)"
  echo "gtk text-scale: $(gsettings get org.gnome.desktop.interface text-scaling-factor 2>/dev/null || echo n/a)"
  echo "effective     : $(fc-match -v 'Noto Sans' 2>/dev/null | grep -E 'hintstyle|rgba' | tr -d ' \t' | tr '\n' ' ')"
  ;;
*) echo "usage: crisp apply [comfort] | dpi <N> | status | revert" ;;
esac
