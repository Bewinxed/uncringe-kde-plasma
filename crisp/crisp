#!/usr/bin/env bash
# Crisp text at native scale on the Neo G9.
#
# WHY
#   Display scaling (1.25) and font DPI are DIFFERENT levers and only one of them
#   is right here. Scaling renders the UI at 96 DPI then *resamples* it: bigger,
#   but every cached bitmap gets interpolated - that is the blurry-favicon bug
#   (Chromium needs 20px icons at 1.25 and only has 16px cached, so it upscales).
#   Raising font DPI instead makes Qt render glyphs at a larger pixel size
#   NATIVELY: bigger AND sharper, nothing resampled, favicons untouched.
#
#   Font DPI had never been set on this box (96, both force keys unset), so the
#   correct lever was simply unused.
#
#   Subpixel AA is NOT the issue and X11 is not the fix. Measured on this machine:
#   Chromium page text is 82-84% colour-fringed (subpixel active) while KDE panel
#   text is 0.4% (grayscale) - same Wayland session. It is a Qt choice, not a
#   Wayland limit. Plasma 6.8 (end of 2026) is Wayland-only anyway.
#
#   For the "thin, washed-out light-on-dark" complaint the lever that actually
#   works on TrueType fonts like Noto Sans is hintfull + FreeType interpreter
#   version 35, which snaps stems hard to the pixel grid (the old MS/ClearType
#   look). Stem darkening is deliberately NOT used: FreeType's TrueType driver
#   does not implement it, so it would be a no-op here.
#
# Usage: crisp apply | revert | status
set -euo pipefail

# Size parity maths: the old setup was 96 DPI x 1.25 scale = 120 DPI equivalent.
# So 120 at scale 1.0 reproduces the previous text size while rendering natively.
# Go higher for bigger text - it stays crisp, because glyphs are rasterised at the
# larger size rather than upscaled.
DPI=${CRISP_DPI:-120}
# GTK apps read none of KDE's font settings. Methodology borrowed from
# github.com/acrion/wayland-font-dpi: propagate the same factor to GTK via
# gsettings text-scaling-factor (text-only, immediate effect, no relogin).
# Their auto-DPI-from-EDID part is deliberately NOT used: this panel is a true
# 96.0 DPI display, so their formula returns factor 1.000 - a no-op. The DPI
# here is a comfort choice, not a physical correction.
GTK_FACTOR=$(python3 -c "print(round($DPI/96, 4))")
OUT=${CRISP_OUTPUT:-DP-1}
FC="$HOME/.config/fontconfig/conf.d/99-crisp.conf"
ENVD="$HOME/.config/environment.d/95-crisp.conf"
KG="$HOME/.config/kdeglobals"
BAK="$HOME/.config/kdeglobals.crisp-bak"
FTPROPS="truetype:interpreter-version=35"

scale_now() { kscreen-doctor -o 2>/dev/null | sed -E 's/\x1b\[[0-9;]*m//g' \
  | grep -A20 "$OUT" | grep -oP 'Scale: \K[0-9.]+' | head -1; }

case ${1:-status} in
apply)
  [[ -f $BAK ]] || cp -a "$KG" "$BAK"
  echo ":: font DPI -> $DPI (native glyph rendering, not resampling)"
  kwriteconfig6 --file kdeglobals --group General --key forceFontDPI "$DPI"
  kwriteconfig6 --file kdeglobals --group General --key forceFontDPIWayland "$DPI"
  echo ":: hinting -> hintfull (snaps stems to the pixel grid)"
  kwriteconfig6 --file kdeglobals --group General --key XftHintStyle hintfull

  echo ":: fontconfig override -> $FC"
  mkdir -p "$(dirname "$FC")"
  cat > "$FC" <<'EOF'
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!-- Written by `crisp`. Delete this file (or run `crisp revert`) to undo. -->
<fontconfig>
  <match target="font">
    <edit name="antialias"  mode="assign"><bool>true</bool></edit>
    <edit name="hinting"    mode="assign"><bool>true</bool></edit>
    <edit name="hintstyle"  mode="assign"><const>hintfull</const></edit>
    <edit name="rgba"       mode="assign"><const>rgb</const></edit>
    <edit name="lcdfilter"  mode="assign"><const>lcddefault</const></edit>
  </match>
</fontconfig>
EOF

  # ~/.config/fontconfig/fonts.conf is parsed AFTER conf.d/, so it overrides the
  # file above. hintstyle has to be changed at its real source or it silently loses.
  FONTSCONF="$HOME/.config/fontconfig/fonts.conf"
  if [[ -f $FONTSCONF ]] && grep -q 'hintslight' "$FONTSCONF"; then
    [[ -f $FONTSCONF.crisp-bak ]] || cp -a "$FONTSCONF" "$FONTSCONF.crisp-bak"
    sed -i 's|<const>hintslight</const>|<const>hintfull</const>|' "$FONTSCONF"
    echo ":: fonts.conf hintslight -> hintfull (it outranks conf.d)"
  fi

  if command -v gsettings >/dev/null 2>&1; then
    echo ":: GTK text-scaling-factor -> $GTK_FACTOR (immediate, no relogin)"
    gsettings set org.gnome.desktop.interface text-scaling-factor "$GTK_FACTOR" || true
  fi

  echo ":: FreeType interpreter 35 -> $ENVD"
  mkdir -p "$(dirname "$ENVD")"
  echo "FREETYPE_PROPERTIES=$FTPROPS" > "$ENVD"
  systemctl --user set-environment "FREETYPE_PROPERTIES=$FTPROPS" 2>/dev/null || true

  # scale LAST: it is the only step that can disturb panel geometry
  echo ":: display scale $(scale_now) -> 1.0  (removes all bitmap resampling)"
  kscreen-doctor "output.$OUT.scale.1" >/dev/null 2>&1 || echo "   !! scale change failed"
  sleep 2
  echo ":: now scale=$(scale_now)"
  echo
  echo "Log out and back in for font DPI to reach every app."
  echo "If the panel misbehaves: resetpanel, or relogin."
  ;;
dpi)
  N=${2:?usage: crisp dpi <number>   e.g. 120 parity, 132 bigger, 144 much bigger}
  kwriteconfig6 --file kdeglobals --group General --key forceFontDPI "$N"
  kwriteconfig6 --file kdeglobals --group General --key forceFontDPIWayland "$N"
  command -v gsettings >/dev/null 2>&1 && \
    gsettings set org.gnome.desktop.interface text-scaling-factor "$(python3 -c "print(round($N/96,4))")" || true
  echo ":: font DPI -> $N (Qt + GTK)   (96=native, 120=old apparent size, 132/144=bigger)"
  echo ":: run 'relogin' to apply - Qt reads this only at session start"
  ;;
revert)
  [[ -f $BAK ]] && cp -a "$BAK" "$KG" && echo ":: kdeglobals restored"
  FONTSCONF="$HOME/.config/fontconfig/fonts.conf"
  [[ -f $FONTSCONF.crisp-bak ]] && cp -a "$FONTSCONF.crisp-bak" "$FONTSCONF" \
    && echo ":: fonts.conf restored (hintslight)"
  rm -f "$FC" "$ENVD" && echo ":: fontconfig + env overrides removed"
  command -v gsettings >/dev/null 2>&1 && gsettings set org.gnome.desktop.interface text-scaling-factor 1.0 || true
  systemctl --user unset-environment FREETYPE_PROPERTIES 2>/dev/null || true
  kscreen-doctor "output.$OUT.scale.1.25" >/dev/null 2>&1 && echo ":: scale back to 1.25"
  echo "Log out and back in."
  ;;
status)
  echo "display scale : $(scale_now)"
  for k in forceFontDPI forceFontDPIWayland XftHintStyle XftSubPixel XftAntialias; do
    printf '  %-20s %s\n' "$k" "$(kreadconfig6 --file kdeglobals --group General --key $k 2>/dev/null || echo unset)"
  done
  echo "fontconfig    : $([[ -f $FC ]] && echo "override present" || echo none)"
  echo "freetype      : ${FREETYPE_PROPERTIES:-unset in this shell}; file=$([[ -f $ENVD ]] && echo present || echo none)"
  echo "gtk text-scale: $(gsettings get org.gnome.desktop.interface text-scaling-factor 2>/dev/null || echo n/a)"
  echo "effective     : $(fc-match -v 'Noto Sans' 2>/dev/null | grep -E 'hintstyle|rgba' | tr -d ' \t' | tr '\n' ' ')"
  ;;
*) echo "usage: crisp apply | revert | status" ;;
esac
